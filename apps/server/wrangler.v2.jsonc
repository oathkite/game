{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keropod-server-v2",
  "main": "src/cf/v2.ts",
  "compatibility_date": "2026-09-10",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      { "name": "DIRECTORY", "class_name": "RoomDirectory" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject", "RoomDirectory"] }],
  "vars": { "ALLOWED_ORIGINS": "http://127.0.0.1:5186,http://localhost:5186" },
  "observability": { "enabled": true }
}
